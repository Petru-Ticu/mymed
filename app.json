{
  "name": "myMed",
  "slug": "mymed",
  "platforms": ["ios", "android"],
  "version": "1.0.0",
  "orientation": "portrait",
  "userInterfaceStyle": "light",
  "runtimeVersion": "exposdk:58.0.0",
  "ios": {
    "supportsTablet": true,
    "bundleIdentifier": "com.anonymous.app-doidoicinci"
  },
  "android": {
    "adaptiveIcon": {
      "backgroundColor": "#ffffff"
    },
    "package": "com.anonymous.app_doidoicinci",
    "softwareKeyboardLayoutMode": "pan",
    "permissions": [
      "android.permission.CAMERA"
    ]
  },
  "plugins": [
    [
      "expo-camera",
      {
        "cameraPermission": "myMed uses the camera to scan medicine barcodes and QR codes so it can fill in the medicine form.",
        "microphonePermission": false,
        "recordAudioAndroid": false
      }
    ]
  ],
  "extra": {
    "eas": {
      "projectId": "3137aae9-130e-492a-b413-db29646384d3"
    }
  },
  "owner": "petru-ticu",
  "updates": {
    "url": "https://u.expo.dev/3137aae9-130e-492a-b413-db29646384d3"
  }
}
