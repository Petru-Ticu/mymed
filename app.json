{
  "name": "myMed",
  "slug": "mymed",
  "version": "1.0.0",
  "orientation": "portrait",
  "userInterfaceStyle": "light",
  "newArchEnabled": true,
  "ios": {
    "supportsTablet": true,
    "bundleIdentifier": "com.anonymous.app-doidoicinci"
  },
  "android": {
    "adaptiveIcon": {
      "backgroundColor": "#ffffff"
    },
    "package": "com.anonymous.app_doidoicinci",
    "softwareKeyboardLayoutMode": "pan"
  },
  "plugins": [
    [
      "expo-notifications",
      {
        "color": "#D1FFD1",
        "defaultChannel": "medicine-reminders"
      }
    ],
    [
      "expo-camera",
      {
        "cameraPermission": "myMed uses the camera to scan medicine barcodes and QR codes so it can fill in the medicine form.",
        "microphonePermission": false,
        "recordAudioAndroid": false
      }
    ]
  ]
}
